{
  "Storage": {
    "RootPath": "storage",
    "OriginalsPath": "originals",
    "StickersPath": "stickers",
    "PreviewsPath": "previews",
    "MaxUploadBytes": 104857600
  },
  "Sticker": {
    "MaxDurationMs": 30000
  },
  "Ffmpeg": {
    "ExecutablePath": "C:\\ffmpeg\\bin\\ffmpeg.exe",
    "ProbeExecutablePath": "C:\\ffmpeg\\bin\\ffprobe.exe"
  },
  "Persistence": {
    "Provider": "PostgreSql",
    "ConnectionStringName": "Postgres",
    "AutoCreateSchema": true
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=soundsticker;Username=postgres;Password=postgres"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
