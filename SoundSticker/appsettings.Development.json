{
  "Storage": {
    "RootPath": "storage",
    "OriginalsPath": "originals",
    "StickersPath": "stickers",
    "PreviewsPath": "previews",
    "TempPath": "temp",
    "TempFileMaxAgeHours": 24,
    "TempCleanupIntervalHours": 12,
    "MaxUploadBytes": 104857600
  },
  "Sticker": {
    "MaxDurationMs": 30000,
    "ProcessingTimeoutSeconds": 45
  },
  "Ffmpeg": {
    "ExecutablePath": "ffmpeg",
    "ProbeExecutablePath": "ffprobe"
  },
  "Persistence": {
    "Provider": "PostgreSql",
    "ConnectionStringName": "Postgres",
    "AutoCreateSchema": true
  },
  "ConnectionStrings": {
    "Postgres": "Host=127.0.0.1;Port=5432;Database=soundsticker;Username=appuser;Password=VeryStrongPassword123"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
